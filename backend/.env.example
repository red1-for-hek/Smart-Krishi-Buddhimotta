# Configure these in Render's Environment tab; never commit real secrets.
GROQ_API_KEY=
FRONTEND_URL=https://your-app.vercel.app
# Image analysis uses this model when GROQ_API_KEY is configured. Photos are sent to Groq.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Fast text-only model routing (chat and optional explanations):
GROQ_MODEL_PRIMARY=openai/gpt-oss-20b
GROQ_MODEL_FALLBACKS=llama-3.1-8b-instant
# Best-effort official DAE PPW live lookup when no curated exact-use record matches.
# It sends only the AI crop/disease terms (never the image) and defaults to enabled.
DAE_LIVE_LOOKUP_ENABLED=true
